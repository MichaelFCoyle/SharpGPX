<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<PropertyGroup>
		<Company>Blue Toque Software</Company>
		<Version>2.25.1230</Version>
		<Copyright>Copyright © Blue Toque Software 2025</Copyright>
		<Authors>Michael Coyle</Authors>
		<Description>Read and write GPX Files</Description>
		<AssemblyName>BlueToque.SharpGPX</AssemblyName>
		<AssemblyVersion>2.25.1230</AssemblyVersion>
		<FileVersion>2.25.1230</FileVersion>
	</PropertyGroup>

	<PropertyGroup>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/BlueToque/SharpGPX</RepositoryUrl>
		<PackageId>BlueToque.SharpGPX</PackageId>
		<PackageTags>gpx,geospatial,gps</PackageTags>
		<RepositoryType>Git</RepositoryType>
		<PackageReleaseNotes>
			* Issue #8: "ele" field saving
			* Issue #9: Garmin RoutePointExtension
		</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Update="GPX1_0\gpx.xsd">
			<Generator>XsdCodeGenerator</Generator>
		</None>
	</ItemGroup>

</Project>
